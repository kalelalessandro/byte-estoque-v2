# Credenciais do banco MySQL local (Docker).
# Copie este arquivo para .env e ajuste os valores se quiser:
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
#
# NUNCA use estas credenciais em produção.

# Senha do usuario administrador do servidor MySQL.
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# Banco criado automaticamente na primeira subida do container.
MYSQL_DATABASE=crm_estoque

# Usuário da aplicacão (o backend escolhido deve usar ESTE usuario, não o root).
MYSQL_USER=app_crm
MYSQL_PASSWORD=troque-esta-senha-app

# Mude para 3307 se ja existir outro MySQL usando a 3306 na sua maquina.
MYSQL_PORT=3306
