# Copie este arquivo para backend/.env para ajustar configurações locais.
# As credenciais do MySQL continuam vindo de database/.env.

# Chave usada para assinar o cookie de sessão. Troque por algo aleatório.
FLASK_SECRET_KEY=troque-por-uma-chave-aleatoria

# Servidor de desenvolvimento.
FLASK_DEBUG=1
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# Origens liberadas para o frontend (separadas por vírgula). Vazio = nenhuma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
